# ── Ollama (Local LLM) ──────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b-instruct-q4_K_M
# Fallback options: llama3.2:3b, qwen2.5:3b-instruct

# ── Travelpayouts / Aviasales Flight Data API ───────
# Sign up free at https://www.travelpayouts.com — token appears immediately in your
# profile under "API token", no approval needed.
TRAVELPAYOUTS_API_TOKEN=your_travelpayouts_api_token_here
# Optional: your affiliate marker (also in your profile). Not required for read-only search.
TRAVELPAYOUTS_MARKER=

# ── Currency Conversion API (bonus feature) ─────────
# Frankfurter (frankfurter.dev) needs no key.
# If using exchangerate-api.com instead, set this:
EXCHANGE_RATE_API_KEY=

# ── App Settings ─────────────────────────────────────
DEFAULT_CURRENCY=UZS
LOG_LEVEL=INFO
STREAMLIT_SERVER_PORT=8501
